# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# One-time file repository setup (Project Settings → Database → Connection string → URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# INTERNAL_FILES_SETUP_SECRET=choose-a-long-random-secret

# Local one-time setup:
# npm run db:setup-files
# supabase/migrations/003_create_internal_messaging.sql (messaging room)
# supabase/migrations/004_create_crm_leads.sql (CRM pipeline)
# supabase/migrations/005_create_platform_users.sql (login users)
# supabase/migrations/006_create_strategy_items.sql (strategy matrix)
# supabase/migrations/007_create_competitors.sql (competitor tracking)
# supabase/migrations/008_create_internal_whiteboard.sql (shared whiteboard)

# Apply competitors + whiteboard tables locally:
# npm run db:setup-internal

# Session signing for platform login (optional; falls back to SUPABASE_ANON_KEY)
# AUTH_SECRET=choose-a-long-random-secret

# WebODM public dashboard URL (browser links; required in production)
# NEXT_PUBLIC_WEBODM_URL=https://your-webodm-host.example.com

# WebODM server API URL (server-side only; required in production)
# WEBODM_URL=https://your-webodm-host.example.com

# WebODM API credentials (server-side only — do not commit .env.local)
# WEBODM_USERNAME=your_webodm_username
# WEBODM_PASSWORD=your_webodm_password

# Local dev only — when unset and NODE_ENV=development, defaults to http://localhost:8000
# NEXT_PUBLIC_WEBODM_URL=http://localhost:8000
# WEBODM_URL=http://localhost:8000

# Zoho Mail (server-side only — IMAP/SMTP via imap.zoho.eu / smtp.zoho.eu)
# ZOHO_INFO_EMAIL=info@dronecatalyst.com
# ZOHO_INFO_PASSWORD=your-app-specific-password
# ZOHO_PAUL_EMAIL=paul@dronecatalyst.com
# ZOHO_PAUL_PASSWORD=your-app-specific-password
