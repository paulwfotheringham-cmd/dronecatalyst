# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# One-time file repository setup (Project Settings → Database → Connection string → URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# INTERNAL_FILES_SETUP_SECRET=choose-a-long-random-secret

# Local one-time setup:
# npm run db:setup-files

# WebODM dashboard URL (local dev default; set to hosted URL in production)
NEXT_PUBLIC_WEBODM_URL=http://localhost:8000

# WebODM API credentials (server-side only — do not commit .env.local)
WEBODM_USERNAME=your_webodm_username
WEBODM_PASSWORD=your_webodm_password
